# Application
APP_NAME="AI Disease Prediction API"
DEBUG=true
API_PREFIX="/api"

# ML Model
MODEL_NAME="xgboost"
MODEL_PATH="../ai_engine/models/xgboost.joblib"
PROCESSED_DATA_PATH="../ai_engine/data/processed"

# CORS — allowed frontend origins (comma-separated)
# Development: React dev server
# Production: replace with actual domain(s)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Database (PostgreSQL — filled in later)
DATABASE_URL="postgresql+psycopg://USER:PASSWORD@localhost:5432/DB_NAME"

# Redis (for USSD sessions — filled in later)
REDIS_URL="redis://localhost:6379/0"

# JWT
JWT_SECRET_KEY="change-me-generate-with-openssl-rand-hex-32"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION_MINUTES=30